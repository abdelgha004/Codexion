#include "../codexion.h"

int	config_validator(t_config *conf)
{
	if (conf->number_of_coders < 1)
		return (6);
	if (conf->time_to_burnout < 1)
		return (6);
	if (conf->time_to_compile < 1)
		return (6);
	if (conf->time_to_debug < 1)
		return (6);
	if (conf->time_to_refactor < 1)
		return (6);
	if (conf->number_of_compiles_required < 1)
		return (6);
	if (conf->dongle_cooldown < 0)
		return (6);
	return (0);
}

int	validate_arguments(int argc, char **argv, t_config *conf)
{
	int	parser_valid;
	int	config_valid;

	parser_valid = parse_arguments(argc, argv, conf);
	if (parser_valid)
		return (parser_valid);
	config_valid = config_validator(conf);
	if (config_valid)
		return (config_valid);
	return (0);
}
