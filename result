void	*coder(void *args)
{
	t_config	*conf;
	t_coder		*coder;

	coder = (t_coder *)(args);
	conf = coder->conf;
	if (coder->id % 2)
		usleep(500);
	while (!is_sim_end(conf))
	{
		if (dongle_logic(coder))
			return (NULL);
		coder_compile(coder);
		if (is_coder_finished(coder))
			return (NULL);
		coder_debug_refactor(coder);
	}
	return (NULL);
}

